# DepthViz frontend environment (Vite). Copy to .env and fill in.
# All VITE_-prefixed vars are inlined into the client bundle — never put secrets
# here (the Supabase anon key is public by design; never the service key).

# Supabase project — required. src/lib/supabase.ts throws at import without these.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# depthviz-api backend base URL — optional. Defaults to /api (use a dev proxy or
# a reverse proxy that routes /api to the backend). Example for local dev:
# VITE_API_URL=http://localhost:8000
VITE_API_URL=/api
