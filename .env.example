# DepthViz frontend environment (Vite). Copy to .env and fill in.
# All VITE_-prefixed vars are inlined into the client bundle — never put secrets
# here (the Supabase anon key is public by design; never the service key).

# Supabase project — required. src/lib/supabase.ts throws at import without these.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# depthviz-api deployment mount/base URL — optional. This is NOT the API version.
# The client transport appends the canonical /api/v1 namespace automatically.
#
# Production behind the same-origin reverse proxy:
VITE_API_URL=/api
#
# Direct backend during local development can instead be the backend origin:
# VITE_API_URL=http://localhost:8000
